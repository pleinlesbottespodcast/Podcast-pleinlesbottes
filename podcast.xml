  <channel>

    <!-- ========================================================= -->
    <!-- INFORMATIONS GÉNÉRALES DU PODCAST                         -->
    <!-- ========================================================= -->

    <!-- Nom du podcast -->
    <title>Plein les Bottes</title>

    <!-- Description générale du podcast -->
    <description>
      Podcast qui invite à un nouveau regard avec des paysans, naturalistes, activistes dans une ambiance détendu et en essayant d'être le plus rôle possible ;-)
    </description>

    <!-- Site internet du podcast -->
    <link>https://podcast-pleinlesbottes.pleinlesbottes-podcast.workers.dev/</link>

    <!-- Langue -->
    <language>fr-FR</language>

    <!-- Auteur / créateur -->
    <itunes:author>Marmotte et Ecureil</itunes:author>

    <!-- Adresse e-mail de contact -->
    <itunes:owner>
      <itunes:name>Marmotte et Ecureil</itunes:name>
      <itunes:email>pleinlesbottes.pocast@gmail.com</itunes:email>
    </itunes:owner>

    <!-- Contenu explicite : false = non explicite -->
    <itunes:explicit>false</itunes:explicit>

    <!-- Catégorie Apple Podcasts -->
    <itunes:category text="Society &amp; Culture"/>

    <!-- Image du podcast -->
    <itunes:image
      href="https://[[TON-DOMAINE]]/image.jpg"/>

    <!-- Copyright -->
    <copyright>
      &#xA9; 2026 Marmotte et Ecureil
    </copyright>


    <!-- ========================================================= -->
    <!-- ÉPISODE 1                                                 -->
    <!-- ========================================================= -->

    <item>

      <!-- Titre de l'épisode -->
      <title>[[TITRE DE L'ÉPISODE 1]]</title>

      <!-- Description de l'épisode -->
      <description>
        [[DESCRIPTION DE L'ÉPISODE 1]]
      </description>

      <!-- Date de publication -->
      <pubDate>Wed, 26 Aug 2026 18:00:00 +0200</pubDate>

      <!--
        URL du fichier MP3
        length = taille du fichier en octets
        type = type du fichier
      -->
      <enclosure
        url="https://[[URL-R2]]/episodes/episode-01.mp3"
        length="[[TAILLE DU MP3 EN OCTETS]]"
        type="audio/mpeg"/>

      <!--
        Identifiant unique de l'épisode.
        NE JAMAIS le modifier après publication.
      -->
      <guid isPermaLink="false">
        [[IDENTIFIANT-UNIQUE-EPISODE-01]]
      </guid>

      <!-- Durée : HH:MM:SS -->
      <itunes:duration>[[00:45:30]]</itunes:duration>

      <!-- Épisode complet -->
      <itunes:episodeType>full</itunes:episodeType>

      <!-- Numéro de l'épisode -->
      <itunes:episode>1</itunes:episode>

    </item>


